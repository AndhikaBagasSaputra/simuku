# Salin file ini menjadi .env.local lalu isi dari Supabase: Project Settings -> API
# (di Vercel: Settings -> Environment Variables, nama yang sama)
VITE_SUPABASE_URL=https://xxxxxxxx.supabase.co
VITE_SUPABASE_KEY=sb_publishable_xxxxxxxx

# Notifikasi pengingat tagihan (buat dengan: npx web-push generate-vapid-keys)
VITE_VAPID_PUBLIC_KEY=
# Hanya di Vercel (rahasia, jangan diberi awalan VITE_):
# VAPID_PRIVATE_KEY=
# SUPABASE_SERVICE_ROLE_KEY=
# CRON_SECRET=
